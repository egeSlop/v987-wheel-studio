{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/.local/share/v987-wheel-studio/**"
        },
        {
          "path": "$HOME/.config/v987-wheel-studio/**"
        },
        {
          "path": "$HOME/.local/share/v987-wheel-studio"
        },
        {
          "path": "$APPDATA/v987-wheel-studio"
        },
        {
          "path": "$APPDATA/v987-wheel-studio/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    }
  ]
}