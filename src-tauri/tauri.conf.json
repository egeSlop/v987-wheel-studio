{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "V987 Wheel Studio",
  "version": "0.3.0",
  "identifier": "dev.egeadam.v987wheelstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "V987 Wheel Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {},
    "shortDescription": "LiteStar / Rampage Pace V987 wheel settings and FFB server",
    "category": "Game"
  }
}